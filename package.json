{
  "name": "gamedash",
  "version": "1.0.0",
  "description": "GameDash — Gaming Center Management System with deterministic time tracking, overtime billing, and session controls",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run server\" \"npm run client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "server": "node server/src/server.js",
    "build": "npm run build --prefix client",
    "preview": "npm run preview --prefix client",
    "start": "node server/src/server.js",
    "test": "node --test server/src/tests/*.test.js",
    "test:server": "npm test --prefix server"
  },
  "keywords": [
    "gaming-center",
    "billing",
    "session-management",
    "gamedash"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "mongoose": "^8.10.1",
    "nodemailer": "^10.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
