# GameDashboard Server Environment Variables
PORT=4000
NODE_ENV=development

# MongoDB Connection String (leave blank for in-memory store)
MONGO_URI=mongodb://localhost:27017/GameDashboard

# Notification Email
OWNER_EMAIL=owner@gamingcenter.com

# Optional SMTP Settings (if not provided, mock transport logs to console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password

# WhatsApp 5-Minute Warning Notifications
# Provider choice: 'local_qr' (default, local gateway/Baileys) or 'cloud_api' (Meta Graph API / Twilio)
WHATSAPP_PROVIDER=local_qr
# Local QR Gateway settings (Approach 2)
# WHATSAPP_GATEWAY_URL=http://localhost:3001
# WHATSAPP_GATEWAY_API_KEY=your_secret_gateway_key

# Meta Cloud API settings (Approach 1 - for zero-code future switch)
# WHATSAPP_CLOUD_TOKEN=your_meta_system_user_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_WARNING_TEMPLATE=session_expiry_warning

# Global fallback manager phone if user has not set their number in their profile
# MANAGER_WHATSAPP_PHONE=919876543210

